{
  "name": "keu-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Karwan e Usmania International · Travel & Tours — Umrah travel website (React SPA + Vercel API)",
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"yellow.bold,cyan.bold\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node scripts/dev-api.js",
    "vercel-dev": "vercel dev",
    "build": "vite build && node scripts/generate-seo.js",
    "preview": "vite preview",
    "optimize:images": "node scripts/optimize-images.js",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:og": "node scripts/generate-og.js",
    "warm:images": "node scripts/warm-images.mjs",
    "seed:admin": "node scripts/seed-admin.js",
    "hero:safe": "node scripts/hero-safe-zones.js"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie": "^1.0.1",
    "dotenv": "^16.4.5",
    "gsap": "^3.13.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.0",
    "mongoose": "^8.7.0",
    "nodemailer": "^6.9.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "express": "^4.21.0",
    "sharp": "^0.33.2",
    "terser": "^5.27.0",
    "vite": "^5.4.10"
  }
}
