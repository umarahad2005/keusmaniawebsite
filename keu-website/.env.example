# Copy to .env and fill in. Never commit .env. See ../README.md#environment-variables

# Database
MONGODB_URI=

# Admin login (no default exists in the code)
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Cloudinary (server-side signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Cloudinary (browser)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Contact-form emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Optional
# VITE_SITE_URL=https://usmania.vercel.app
# VITE_ANALYTICS=vercel
